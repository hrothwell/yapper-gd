func test_deserializes_poll_details():
	var generator = PollDetailsGenerator.new()
	var json = generator.Get()
	var result = LiveChatDeserializer.deserialize_message(json)
	_base_assert(result)
	assert_eq(result.snippet.type, LiveChatMessageSnippet.Type.POLL_EVENT)
	assert_eq(result.snippet.poll_details.metadata.question_text, "question text")
	assert_eq(result.snippet.poll_details.metadata.options.size(), 2)
	assert_eq(result.snippet.poll_details.metadata.options.get(0).option_text, "option text")
	assert_eq(result.snippet.poll_details.metadata.options.get(0).tally, 1)
	assert_eq(result.snippet.poll_details.metadata.options.get(1).option_text, "option text 2")
	assert_eq(result.snippet.poll_details.metadata.options.get(1).tally, 2)
	assert_eq(result.snippet.poll_details.status, LiveChatPollDetails.PollStatus.CLOSED)

